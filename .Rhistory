items <- paste0("ts", 1:21)
fits <- list(Unidimensional = FitUni, Correlated = FitSimple,
SecondOrder = Fit_SecondOrder, Bifactor = FitBi)
# 1. Fit comparison table
fit_table <- t(sapply(fits, fitMeasures,
c("chisq","df","pvalue","cfi","tli","rmsea","srmr","aic","bic")))
round(fit_table, 3)
# 2. Item-level standardized loadings, all models side by side
load_table <- bind_rows(lapply(names(fits), function(m)
standardizedSolution(fits[[m]]) %>%
filter(op == "=~", rhs %in% items) %>%
transmute(item = rhs, col = paste(m, lhs, sep = "_"), est = round(est.std, 2))
)) %>%
pivot_wider(names_from = col, values_from = est) %>%
arrange(as.numeric(sub("ts", "", item)))
library(lavaan)
